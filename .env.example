# ── Server ──────────────────────────────────────────────────────────────────
# Terminate TLS in a reverse proxy (Caddy/nginx) in front of this process.
HOST=127.0.0.1
PORT=8082
LOG_LEVEL=info

# ── Signing key ─────────────────────────────────────────────────────────────
# Ed25519 keypair used to sign every claim. If missing, a fresh keypair is
# generated on first start and written to DATA_DIR/agent-ed25519.json (mode
# 0600). The public half is served at GET /publickey.
# DATA_DIR=./data

# ── Fetcher limits ──────────────────────────────────────────────────────────
# Max response body accepted (bytes). Larger responses fail the witness call.
MAX_BODY_BYTES=1048576
# Total wall-clock budget for one fetch incl. redirects (ms).
FETCH_TIMEOUT_MS=15000
# Max redirect hops followed (each hop is re-validated for SSRF).
MAX_REDIRECTS=3
# TEST ONLY — allows fetches to loopback/private ranges (the local test
# harness needs this). NEVER enable in production.
ALLOW_PRIVATE_TARGETS=false
# Optional host allowlist/denylist (comma-separated, e.g. "api.example.com,*");
# empty = allow all public hosts.
FETCH_ALLOW_HOSTS=
FETCH_DENY_HOSTS=

# ── Rate limiting ───────────────────────────────────────────────────────────
# Requests per IP per window; window in seconds.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_S=60
# Max concurrent outbound fetches across the whole service.
MAX_CONCURRENT_FETCHES=4

# ── zkVerify anchor ─────────────────────────────────────────────────────────
# none   = no on-chain anchor (claims stay signed + hash-committed only)
# volta  = anchor commitment via system.remark on zkVerify Volta testnet
# mainnet= same, on zkVerify mainnet
ANCHOR_MODE=none
# Account used to submit the remark extrinsic (mnemonic or SURI).
# NEVER commit, NEVER paste into chat. Fund it from the Volta faucet —
# a remark costs a tiny fee; keep ~0.1 VFY on it.
ZKV_ANCHOR_SEED=
# Endpoints (defaults shown; override only if you run your own node).
ZKV_RPC_WSS=wss://zkverify-volta-rpc.zkverify.io
ZKV_EXPLORER=https://zkverify-testnet.subscan.io/
# Wait budget for one anchor (ms) and poll interval.
ANCHOR_TIMEOUT_MS=120000
ANCHOR_POLL_MS=6000
